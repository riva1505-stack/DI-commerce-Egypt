# Optional configuration. Copy this file to .env and modify it if desired.
# .env is loaded by start.py for LOCAL RUN ONLY; for production use host env vars.
APP_ENV=development
ADMIN_PASSWORD=demo12345
# Preferred for production: generate with python hash_admin_password.py.
# A nonempty hash takes precedence over ADMIN_PASSWORD; remove the plaintext value.
ADMIN_PASSWORD_HASH=
# Blank in local development generates a new random key on each app start.
# Production requires an explicit random key of at least 32 characters.
SECRET_KEY=
PUBLIC_BASE_URL=http://127.0.0.1:8000
# To activate a REAL generative AI conversation and server-side voice, set a
# provider API key (do not paste it into frontend code).
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini
VOICE_API_ENABLED=1
VOICE_STT_MODEL=gpt-4o-mini-transcribe
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=coral

# Optional Gemini Developer API trial for Bokharest only.
# Free-tier eligibility and rate limits vary; API access may require billing.
# Create a key in Google AI Studio and set it as a Railway SECRET variable.
# DO NOT place this key in browser code, git, screenshots, or chat messages.
GEMINI_API_KEY=
BOKHAREST_GEMINI_MODEL=gemini-2.5-flash
